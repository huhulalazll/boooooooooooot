<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="人格设定" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="预设模板" android:textSize="14sp" android:layout_marginTop="16dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="人格提示词" android:textSize="14sp" android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etPersona"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:hint="在这里写你的人格设定..." />

        <TextView
            android:id="@+id/tvPersonaLen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 字符"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSavePersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存并应用"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
